---
/**
 * Aviso legal (LSSI-CE, Ley 34/2002, art. 10).
 * IMPORTANTE: es un punto de partida, no asesoramiento legal. Revísalo con un profesional.
 * Rellena los datos en src/config/sitio.ts → legal.
 */
import Base from '../layouts/Base.astro';
import Pie from '../components/Pie.astro';
import { sitio } from '../config/sitio';
const { legal } = sitio;
const pendiente = '[pendiente de completar]';
---

<Base titulo={`Aviso legal · ${sitio.nombre}`}>
  <article class="seccion contenedor legal">
    <h1>Aviso legal</h1>
    <h2>Titular de la web</h2>
    <ul>
      <li><strong>Titular:</strong> {legal.responsable || pendiente}</li>
      <li><strong>NIF/CIF:</strong> {legal.nif || pendiente}</li>
      <li><strong>Domicilio:</strong> {legal.domicilio || pendiente}</li>
      <li><strong>Email:</strong> <a href={`mailto:${legal.emailPrivacidad}`}>{legal.emailPrivacidad}</a></li>
      {legal.datosRegistrales && <li><strong>Datos registrales:</strong> {legal.datosRegistrales}</li>}
    </ul>
    <h2>Objeto</h2>
    <p>Esta web informa sobre los servicios de {sitio.nombre} y permite contactar mediante un formulario. Navegar por ella implica aceptar este aviso legal.</p>
    <h2>Propiedad intelectual</h2>
    <p>Los textos, imágenes, logotipos y diseño de esta web pertenecen a su titular o se usan con permiso. No se pueden reproducir sin autorización.</p>
    <h2>Responsabilidad</h2>
    <p>El titular procura que la información sea correcta y esté actualizada, pero no se hace responsable de errores puntuales ni del contenido de webs externas enlazadas.</p>
    <h2>Protección de datos</h2>
    <p>Consulta la <a href="/privacidad">política de privacidad</a>.</p>
    <h2>Legislación aplicable</h2>
    <p>Este aviso legal se rige por la legislación española.</p>
  </article>
  <Pie slot="pie" />
</Base>

<style>
  .legal { max-width: 46rem; }
  .legal h2 { font-size: 1.35rem; margin-top: 2rem; }
  .legal ul { padding-left: 1.2rem; }
</style>
