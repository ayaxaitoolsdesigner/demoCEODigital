---
import { sitio } from '../config/sitio';
const { hero } = sitio;
---

<header class="hero">
  <div class="contenedor">
  <div class="hero__interior">
    {hero.antetitulo && <p class="hero__antetitulo">{hero.antetitulo}</p>}
    <h1 class="hero__titulo">{hero.titulo}</h1>
    <p class="hero__subtitulo">{hero.subtitulo}</p>
    <div class="hero__acciones">
      <a class="boton boton--principal" href={hero.botonPrincipal.enlace}>{hero.botonPrincipal.texto}</a>
      {
        hero.botonSecundario && (
          <a class="boton boton--secundario" href={hero.botonSecundario.enlace}>
            {hero.botonSecundario.texto}
          </a>
        )
      }
    </div>
  </div>
  </div>
</header>

<style>
  .hero { padding-block: clamp(4rem, 14vw, 10rem) clamp(3rem, 8vw, 6rem); }
  .hero__interior { max-width: 52rem; }
  .hero__antetitulo {
    display: inline-block; font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--color-acento);
    border-bottom: 2px solid currentColor; padding-bottom: 0.15rem; margin-bottom: 1.5rem;
  }
  .hero__titulo { font-size: clamp(2.4rem, 7vw, 4.75rem); letter-spacing: -0.02em; }
  .hero__subtitulo { font-size: clamp(1.125rem, 2.2vw, 1.375rem); color: var(--color-texto-suave); max-width: 40rem; }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
