---
import { sitio } from '../config/sitio';
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor pie__interior">
    <p>© {anio} {sitio.nombre}</p>
    <nav aria-label="Legal">
      <a href="/aviso-legal">Aviso legal</a>
      <a href="/privacidad">Política de privacidad</a>
    </nav>
  </div>
</footer>

<style>
  .pie { border-top: 1px solid var(--color-borde); padding-block: 2rem; font-size: 0.9375rem; color: var(--color-texto-suave); }
  .pie__interior { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  .pie p { margin: 0; }
  .pie nav { display: flex; flex-wrap: wrap; gap: 1.25rem; }
</style>
